<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".Fragments.Fragment_editar_perfil">

    <!-- TODO: Update blank fragment layout -->
    <LinearLayout
        android:id="@+id/linearLayout4"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:background="@drawable/custom_linear_tela_inicio"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/textView"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:text="Edite Seus Dados"
            android:textColor="@color/white"
            android:textSize="40sp"
            android:textStyle="bold" />

    </LinearLayout>

    <EditText
        android:id="@+id/edt_userName"
        android:layout_width="330dp"
        android:layout_height="53dp"
        android:background="@drawable/custom_edit_text"
        android:drawableStart="@drawable/change_user"
        android:layout_marginTop="50dp"
        android:drawablePadding="12dp"
        android:elevation="10dp"
        android:ems="10"
        android:hint="Nome Completo"
        android:paddingStart="25dp"
        android:paddingEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout4" />

    <EditText
        android:id="@+id/edt_bairro"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edt_userName"
        android:layout_width="330dp"
        android:layout_height="53dp"
        android:layout_marginTop="15dp"
        android:background="@drawable/custom_edit_text"
        android:drawableStart="@drawable/change_email"
        android:drawablePadding="12dp"
        android:elevation="10dp"
        android:ems="20"
        android:hint="Bairro"
        android:inputType="textEmailAddress"
        android:paddingStart="25dp"
        android:paddingEnd="12dp" />

    <EditText
        android:id="@+id/edt_cidade"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edt_bairro"
        android:layout_width="330dp"
        android:layout_height="53dp"
        android:layout_marginTop="15dp"
        android:background="@drawable/custom_edit_text"
        android:drawableStart="@drawable/change_email"
        android:drawablePadding="12dp"
        android:elevation="10dp"
        android:ems="20"
        android:hint="Cidade"
        android:inputType="textEmailAddress"
        android:paddingStart="25dp"
        android:paddingEnd="12dp" />

    <EditText
        android:id="@+id/edt_tel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edt_cidade"
        android:layout_width="330dp"
        android:layout_height="53dp"
        android:layout_marginTop="15dp"
        android:background="@drawable/custom_edit_text"
        android:drawableStart="@drawable/change_email"
        android:drawablePadding="12dp"
        android:elevation="10dp"
        android:ems="20"
        android:hint="Telefone Pra Contato"
        android:inputType="textEmailAddress"
        android:paddingStart="25dp"
        android:paddingEnd="12dp" />

    <EditText
        android:id="@+id/edt_password"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edt_tel"
        android:layout_width="330dp"
        android:layout_height="53dp"
        android:layout_marginTop="15dp"
        android:background="@drawable/custom_edit_text"
        android:drawableStart="@drawable/change_senha"
        android:drawablePadding="12dp"
        android:elevation="10dp"
        android:ems="10"
        android:hint="Senha"
        android:inputType="numberPassword"
        android:paddingStart="25dp"
        android:paddingEnd="12dp" />

    <EditText
        android:id="@+id/edt_password_confirmation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edt_password"
        android:layout_width="330dp"
        android:layout_height="53dp"
        android:layout_marginTop="15dp"
        android:background="@drawable/custom_edit_text"
        android:drawableStart="@drawable/change_senha"
        android:drawablePadding="12dp"
        android:elevation="10dp"
        android:ems="10"
        android:hint="Confirmaçao de Senha"
        android:inputType="numberPassword"
        android:paddingStart="25dp"
        android:paddingEnd="12dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_confirmar"
        android:layout_width="330dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/btn_background"
        android:text="Confirmar Alterações"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edt_password_confirmation" />

</androidx.constraintlayout.widget.ConstraintLayout>