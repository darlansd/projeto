<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".Fragments.Fragment_editar_perfil">

    <!-- TODO: Update blank fragment layout -->

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:orientation="vertical"
        android:background="@drawable/custom_linear_bottom_rounded"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:layout_marginStart="30dp"
            android:text="Edite"
            android:fontFamily="@font/montserrat"
            android:textColor="@color/white"
            android:textSize="40sp"
            />

        <TextView
            android:id="@+id/textView"
            android:layout_width="150dp"
            android:layout_height="95dp"
            android:layout_marginStart="30dp"
            android:text="Seus Dados"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="@color/white"
            android:textSize="40sp"
            />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="O que Deseja Alterar?"
        android:fontFamily="@font/montserrat"
        app:layout_constraintBottom_toTopOf="@+id/btn_editar_pessoal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.231"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout"
        app:layout_constraintVertical_bias="0.732" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_editar_pessoal"
        android:layout_width="300dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:layout_marginTop="120dp"
        android:drawableStart="@drawable/ic_informacoes_pessoais"
        android:paddingStart="40dp"
        android:paddingEnd="15dp"
        android:background="@drawable/btn_background"
        android:text="Informaçoes Pessoais"
        android:fontFamily="@font/montserrat"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="19sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.493"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_editar_conta_seg"
        android:layout_width="300dp"
        android:layout_height="60dp"
        android:gravity="center"
        android:layout_marginTop="40dp"
        android:drawableStart="@drawable/ic_change_senha"
        android:drawableTint="@color/white"
        android:paddingStart="50dp"
        android:paddingEnd="40dp"
        android:background="@drawable/btn_background"
        android:text="Conta e Segurança"
        android:fontFamily="@font/montserrat"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="19sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.493"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_editar_pessoal" />

</androidx.constraintlayout.widget.ConstraintLayout>