<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nested"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:isScrollContainer="true"
    android:scrollbarSize="5dp"
    android:scrollbars="vertical"
    tools:context=".Fragments.Fragment_editar_informacoes_pessoais">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:background="@drawable/custom_linear_bottom_rounded"
            android:elevation="10dp"
            android:gravity="center|top|start"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:layout_marginStart="30dp"
                android:layout_marginTop="38dp"
                android:fontFamily="@font/montserrat"
                android:gravity="center|start"
                android:text="Edite"
                android:textColor="@color/white"
                android:textSize="40sp" />

            <TextView
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="start|top"
                android:text="Suas Informações Pessoais"
                android:textColor="@color/white"
                android:textSize="40sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:gravity="center"
                android:orientation="vertical">


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!--todo desenvolver a seleçao de avatar de perfil -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:fontFamily="@font/montserrat_bold"
                            android:text="Mudar Imagem De Perfil:"
                            android:textColor="@color/turquesa_acinzentado"
                            android:textSize="15sp" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/img_imagem_perfil"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                            android:src="@drawable/placeholder_img_perfil"
                            android:scaleType="centerCrop"
                            android:layout_width="125dp"
                            android:layout_height="125dp">

                        </com.google.android.material.imageview.ShapeableImageView>

                    </LinearLayout>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_bold"
                        android:text="Nome Completo:"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/turquesa_acinzentado"
                        android:textSize="15sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layout_novo_nome"
                        android:layout_width="300dp"
                        android:layout_height="wrap_content"
                        app:counterEnabled="false"
                        app:counterMaxLength="15"
                        app:hintAnimationEnabled="false"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edt_novo_nome"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@drawable/custom_edit_text"
                            android:drawableStart="@drawable/ic_change_user"
                            android:drawablePadding="12dp"
                            android:fontFamily="@font/montserrat"
                            android:maxLength="15"
                            android:paddingStart="25dp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_bold"
                        android:text="Endereço (CEP):"
                        android:textColor="@color/turquesa_acinzentado"
                        android:textSize="15sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layout_novo_cep"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="300dp"
                        app:counterEnabled="false"
                        app:counterMaxLength="8"
                        app:hintAnimationEnabled="false"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edt_novo_cep"
                            android:layout_width="wrap_content"
                            android:layout_height="56dp"
                            android:background="@drawable/custom_edit_text"
                            android:drawableStart="@drawable/ic_change_loc"
                            android:drawablePadding="12dp"
                            android:fontFamily="@font/montserrat"
                            android:inputType="number"
                            android:maxLength="8"
                            android:paddingStart="25dp"
                            android:paddingEnd="15dp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>


            </LinearLayout>


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_alterar"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="35dp"
                android:layout_marginBottom="60dp"
                android:background="@drawable/btn_background"
                android:text="Confirmar Alteraçoes"
                android:textColor="@color/white"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>