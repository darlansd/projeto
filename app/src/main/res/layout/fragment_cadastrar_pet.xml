<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Fragments.Fragment_cadastrar_pet">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:background="@drawable/custom_linear_bottom_rounded"
        android:elevation="10dp"
        android:gravity="center|top|start"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="45dp"
            android:fontFamily="@font/montserrat"
            android:gravity="center|start"
            android:text="Vamos"
            android:textColor="@color/white"
            android:textSize="40sp" />

        <TextView
            android:layout_width="220dp"
            android:layout_height="100dp"
            android:layout_marginStart="45dp"
            android:fontFamily="@font/montserrat_bold"
            android:gravity="start"
            android:text="Cadastrar Seu Pet"
            android:textColor="@color/white"
            android:textSize="40sp" />

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_cadastrar_gato"
        android:layout_width="300dp"
        android:layout_height="60dp"
        android:layout_gravity="start"
        android:layout_marginTop="72dp"
        android:background="@drawable/btn_background"
        android:drawableStart="@drawable/ic_patinha"
        android:fontFamily="@font/montserrat"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:text="Cadastrar Gato"
        android:textAllCaps="false"
        android:drawableTint="@color/white"
        android:textColor="@color/white"
        android:textSize="19sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.504"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_cadastrar_cachorro"
        android:layout_width="300dp"
        android:layout_height="60dp"
        android:layout_gravity="start"
        android:layout_marginTop="40dp"
        android:background="@drawable/btn_background"
        android:drawableStart="@drawable/ic_patinha"
        android:fontFamily="@font/montserrat"
        android:paddingStart="40dp"
        android:paddingEnd="20dp"
        android:text="Cadastrar Cachorro"
        android:textAllCaps="false"
        android:drawableTint="@color/white"
        android:textColor="@color/white"
        android:textSize="19sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.504"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_cadastrar_gato" />

</androidx.constraintlayout.widget.ConstraintLayout>