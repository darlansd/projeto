<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="Fragments.Fragment_cadastro">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="270dp"
        android:background="@drawable/custom_linear_bottom_rounded"
        android:elevation="10dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="150dp"
            android:layout_height="44dp"
            android:layout_marginStart="30dp"
            android:layout_marginTop="38dp"
            android:fontFamily="@font/montserrat"
            android:text="Vamos"
            android:textColor="@color/white"
            android:textSize="40sp"
            />

        <TextView
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:text="Criar Sua Conta"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="@color/white"
            android:textSize="40sp"
            />

    </LinearLayout>

    <EditText
        android:id="@+id/edt_userName"
        android:layout_width="330dp"
        android:layout_height="53dp"
        android:layout_marginTop="300dp"
        android:drawableStart="@drawable/ic_change_user"
        android:background="@drawable/custom_edit_text"
        android:paddingStart="25dp"
        android:drawablePadding="12dp"
        android:hint="Nome Completo"
        android:fontFamily="@font/montserrat"
        android:elevation="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/edt_EmailAddress"
        android:layout_width="330dp"
        android:layout_height="53dp"
        android:layout_marginTop="15dp"
        android:drawableStart="@drawable/ic_change_email"
        android:ems="20"
        android:background="@drawable/custom_edit_text"
        android:paddingEnd="12dp"
        android:paddingStart="25dp"
        android:drawablePadding="12dp"
        android:hint="Email de acesso"
        android:fontFamily="@font/montserrat"
        android:inputType="textEmailAddress"
        android:elevation="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edt_userName" />

    <EditText
        android:id="@+id/edt_password"
        android:layout_width="330dp"
        android:layout_height="53dp"
        android:layout_marginTop="15dp"
        android:drawableStart="@drawable/ic_change_senha"
        android:ems="10"
        android:background="@drawable/custom_edit_text"
        android:paddingEnd="12dp"
        android:paddingStart="25dp"
        android:drawablePadding="12dp"
        android:hint="Senha"
        android:fontFamily="@font/montserrat"
        android:inputType="numberPassword"
        android:elevation="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edt_EmailAddress" />

    <EditText
        android:id="@+id/edt_password_confirmation"
        android:layout_width="330dp"
        android:layout_height="53dp"
        android:layout_marginTop="15dp"
        android:drawableStart="@drawable/ic_change_senha"
        android:ems="10"
        android:background="@drawable/custom_edit_text"
        android:paddingEnd="12dp"
        android:paddingStart="25dp"
        android:drawablePadding="12dp"
        android:hint="Confirmaçao de Senha"
        android:fontFamily="@font/montserrat"
        android:inputType="numberPassword"
        android:elevation="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edt_password" />

    <CheckBox
        android:id="@+id/checkBox"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="38dp"
        android:text="Concorda com os"
        android:fontFamily="@font/montserrat"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.183"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edt_password_confirmation" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_continuar"
        android:layout_width="266dp"
        android:layout_height="62dp"
        android:layout_marginTop="35dp"
        android:text="Continuar"
        android:fontFamily="@font/montserrat"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:background="@drawable/btn_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/checkBox" />

</androidx.constraintlayout.widget.ConstraintLayout>